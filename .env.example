# Cloud sync (optional).
# Without these the app runs exactly as before: local-only, no account.
#
# Both values are public by design — they ship inside the JavaScript bundle.
# What protects your data is Row Level Security (see supabase/schema.sql), not
# secrecy of the anon key. Never put the *service role* key here.
#
# Copy this file to .env and fill in the values from
# Supabase Dashboard → Project Settings → API.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
