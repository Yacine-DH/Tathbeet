# Cloud sync (optional).
# Without these the app runs exactly as before: local-only, no account.
#
# Copy this file to .env and fill in the values from
# Supabase Dashboard → Project Settings → API Keys.
# Both are public by design (they ship in the JS bundle); Row Level Security
# protects the data. Never put the secret / service-role key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key-here
